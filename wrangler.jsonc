{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crowdtickermedia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.crowdtickermedia.com", "custom_domain": true }
  ]
}
